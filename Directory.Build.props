<Project>
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <CliporaBuild>1</CliporaBuild>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.$(CliporaBuild)</FileVersion>
    <InformationalVersion>$(VersionPrefix)+build.$(CliporaBuild)</InformationalVersion>
    <Authors>Vlad0s</Authors>
    <Company>Vlad0s</Company>
    <Product>Clipora</Product>
    <Copyright>Copyright © Vlad0s 2026</Copyright>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Build" Value="$(CliporaBuild)" />
    <AssemblyMetadata Include="Developer" Value="Vlad0s" />
  </ItemGroup>
</Project>
