<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clipora.App.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{StaticResource CliporaCanvasBrush}"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageLayout" MinHeight="620" Padding="24">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="PageWidthStates">
                    <VisualState x:Name="MinimumWidth" />
                    <VisualState x:Name="WideWidth">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1200" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PageLayout.Padding" Value="40,28" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <StackPanel
                MaxWidth="900"
                HorizontalAlignment="Stretch"
                Spacing="18">
                <Button
                    x:Uid="AboutBackButton"
                    Click="OnBackClick"
                    Style="{StaticResource BackButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Back" />
                        <TextBlock x:Uid="AboutBackButtonText" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        x:Uid="AboutLogo"
                        Width="72"
                        Height="72"
                        Source="Assets/Brand/LogoMark.png"
                        Stretch="Uniform" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock x:Uid="AboutTitle" Style="{StaticResource HeadingTextStyle}" />
                        <TextBlock x:Uid="AboutSubtitle" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource SurfaceCardStyle}">
                    <Grid ColumnSpacing="24" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="AboutVersionLabel" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Version, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock x:Uid="AboutBuildLabel" Grid.Row="1" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Build, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock x:Uid="AboutDeveloperLabel" Grid.Row="2" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Developer, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock x:Uid="AboutFFmpegLabel" Grid.Row="3" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            MaxLines="3"
                            Style="{StaticResource MonoTextStyle}"
                            Text="{x:Bind ViewModel.FFmpegVersion, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="AboutLicensesHeading" Style="{StaticResource SectionHeadingTextStyle}" />
                        <TextBlock x:Uid="AboutLicensesText" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <HyperlinkButton
                        x:Uid="AboutGitHubButton"
                        NavigateUri="https://github.com/Vlad0s78/Clipora"
                        Style="{StaticResource CliporaHyperlinkButtonStyle}">
                        <TextBlock x:Uid="AboutGitHubButtonText" />
                    </HyperlinkButton>
                    <HyperlinkButton
                        x:Uid="AboutFFmpegWebsiteButton"
                        NavigateUri="https://ffmpeg.org/"
                        Style="{StaticResource CliporaHyperlinkButtonStyle}">
                        <TextBlock x:Uid="AboutFFmpegWebsiteButtonText" />
                    </HyperlinkButton>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
