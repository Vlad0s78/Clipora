<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>Clipora.App</RootNamespace>
    <AssemblyName>Clipora</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeBundledMediaTools Condition="'$(IncludeBundledMediaTools)' == ''">true</IncludeBundledMediaTools>
    <BundledMediaToolsDirectory>$(MSBuildProjectDirectory)\..\..\ffmpeg</BundledMediaToolsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(IncludeBundledMediaTools)' == 'true'">
    <Content Include="$(BundledMediaToolsDirectory)\ffmpeg.exe" Link="Tools\ffmpeg\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(BundledMediaToolsDirectory)\ffprobe.exe" Link="Tools\ffmpeg\ffprobe.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clipora.Core\Clipora.Core.csproj" />
    <ProjectReference Include="..\Clipora.FFmpeg\Clipora.FFmpeg.csproj" />
    <ProjectReference Include="..\Clipora.Media\Clipora.Media.csproj" />
    <ProjectReference Include="..\Clipora.Shell\Clipora.Shell.csproj" />
  </ItemGroup>

  <Target Name="ValidateBundledMediaTools" BeforeTargets="PrepareForBuild" Condition="'$(IncludeBundledMediaTools)' == 'true'">
    <Error Condition="!Exists('$(BundledMediaToolsDirectory)\ffmpeg.exe')" Text="Bundled ffmpeg.exe is missing. Place it in the repository ffmpeg directory or build with IncludeBundledMediaTools=false." />
    <Error Condition="!Exists('$(BundledMediaToolsDirectory)\ffprobe.exe')" Text="Bundled ffprobe.exe is missing. Place it in the repository ffmpeg directory or build with IncludeBundledMediaTools=false." />
  </Target>

  <Target Name="CopyApplicationPriToPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri"
          DestinationFolder="$(PublishDir)"
          Condition="Exists('$(TargetDir)$(AssemblyName).pri')" />
  </Target>
</Project>
