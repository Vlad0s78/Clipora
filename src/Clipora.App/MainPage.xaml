<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clipora.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Clipora.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    AllowDrop="True"
    Background="{StaticResource CliporaCanvasBrush}"
    DragLeave="OnDragLeave"
    DragOver="OnDragOver"
    Drop="OnDrop"
    KeyDown="OnPageKeyDown"
    mc:Ignorable="d">

    <Page.Resources>
        <Style
            x:Key="MetadataCardStyle"
            TargetType="Border">
            <Setter Property="MinHeight" Value="84" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource CliporaBorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style
            x:Key="FileActionButtonStyle"
            BasedOn="{StaticResource CompactButtonStyle}"
            TargetType="Button">
            <Setter Property="MinWidth" Value="204" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="SecondaryActionButtonStyle"
            BasedOn="{StaticResource SecondaryButtonStyle}"
            TargetType="Button">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style
            x:Key="ProgressMetricCardStyle"
            BasedOn="{StaticResource InsetSurfaceBorderStyle}"
            TargetType="Border">
            <Setter Property="MinHeight" Value="78" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style
            x:Key="PreviewTransportButtonStyle"
            BasedOn="{StaticResource QuietButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageLayout" MinHeight="620" Padding="24">
            <Grid
                x:Name="ContentLayout"
                MaxWidth="1200"
                HorizontalAlignment="Stretch">

            <Border
                MinHeight="560"
                Background="{StaticResource CliporaSurfaceBrush}"
                BorderBrush="{StaticResource CliporaBorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource CliporaHeroCornerRadius}"
                Padding="28"
                x:Name="EmptyStatePanel"
                x:Load="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <Grid>
                    <Rectangle
                        x:Name="DropZoneOutline"
                        Fill="Transparent"
                        RadiusX="14"
                        RadiusY="14"
                        Stroke="{StaticResource CliporaBorderStrongBrush}"
                        StrokeDashArray="7,5"
                        StrokeDashCap="Round"
                        StrokeThickness="2" />
                    <StackPanel
                        MaxWidth="600"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="18">
                        <Image
                            Width="140"
                            Height="140"
                            Source="Assets/Brand/LogoMark.png"
                            Stretch="Uniform" />
                        <TextBlock
                            x:Uid="HomeDropTitle"
                            HorizontalAlignment="Center"
                            FontSize="40"
                            Style="{StaticResource HeadingTextStyle}"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            x:Uid="HomeDropSubtitle"
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource CliporaSecondaryBrush}"
                            FontSize="20"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords" />
                        <Button
                            x:Uid="BrowseButton"
                            Margin="0,22,0,0"
                            Width="320"
                            Height="64"
                            HorizontalAlignment="Center"
                            Command="{x:Bind ViewModel.BrowseCommand}"
                            Style="{StaticResource PrimaryButtonStyle}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Width="30"
                                    Height="30"
                                    VerticalAlignment="Center"
                                    Source="Assets/Icons/BrowseFile.png" />
                                <TextBlock
                                    x:Uid="BrowseButtonText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="19"
                                    FontWeight="SemiBold" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                MinHeight="560"
                Style="{StaticResource SurfaceCardStyle}"
                x:Name="LoadingStatePanel"
                x:Load="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="14">
                    <ProgressRing
                        Width="54"
                        Height="54"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                    <TextBlock
                        x:Uid="AnalyzeLoadingTitle"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SectionHeadingTextStyle}" />
                    <TextBlock
                        x:Uid="AnalyzeLoadingDescription"
                        MaxWidth="440"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Border>

            <Border
                MinHeight="560"
                Style="{StaticResource SurfaceCardStyle}"
                x:Name="ErrorStatePanel"
                x:Load="{x:Bind ViewModel.HasError, Mode=OneWay}">
                <StackPanel
                    MaxWidth="520"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="14">
                    <FontIcon
                        FontSize="44"
                        Foreground="{StaticResource CliporaDangerBrush}"
                        Glyph="&#xE783;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SectionHeadingTextStyle}"
                        Text="{x:Bind ViewModel.ErrorTitle, Mode=OneWay}"
                        TextAlignment="Center" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Text="{x:Bind ViewModel.ErrorDescription, Mode=OneWay}"
                        TextAlignment="Center"
                        Style="{StaticResource SecondaryTextStyle}" />
                    <StackPanel
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button
                            x:Uid="ChooseAnotherButton"
                            MinWidth="220"
                            Command="{x:Bind ViewModel.BrowseCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="{x:Bind ViewModel.ShowErrorBrowse, Mode=OneWay}">
                            <TextBlock
                                x:Uid="ChooseAnotherButtonText"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold" />
                        </Button>
                        <Button
                            x:Uid="RetryProcessingButton"
                            MinWidth="180"
                            Command="{x:Bind ViewModel.RetryProcessingCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Visibility="{x:Bind ViewModel.ShowErrorRetry, Mode=OneWay}">
                            <TextBlock
                                x:Uid="RetryCompressionButtonText"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold" />
                        </Button>
                        <Button
                            x:Uid="BackToVideoButton"
                            MinWidth="180"
                            Command="{x:Bind ViewModel.BackToPreviousOperationScreenCommand}"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Visibility="{x:Bind ViewModel.ShowErrorRetry, Mode=OneWay}">
                            <TextBlock
                                x:Uid="BackToVideoButtonText"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid
                RowSpacing="18"
                x:Name="LoadedStatePanel"
                x:Load="{x:Bind ViewModel.IsLoaded, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border MinHeight="104" Style="{StaticResource SurfaceCardStyle}">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="64"
                            Height="64"
                            VerticalAlignment="Center"
                            Background="{StaticResource CliporaRaisedSurfaceBrush}"
                            CornerRadius="{StaticResource CliporaInsetCornerRadius}">
                            <Image
                                Width="44"
                                Height="44"
                                Source="Assets/Icons/Video.png" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="6">
                            <TextBlock
                                Style="{StaticResource SectionHeadingTextStyle}"
                                Text="{x:Bind ViewModel.FileName, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                            <TextBlock
                                Foreground="{StaticResource CliporaSecondaryBrush}"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                Text="{x:Bind ViewModel.FilePath, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                        </StackPanel>

                        <Button
                            x:Uid="ChooseAnotherButton"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.BrowseCommand}"
                            Style="{StaticResource FileActionButtonStyle}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Glyph="&#xE8B7;" />
                                <TextBlock
                                    x:Uid="ChooseAnotherButtonText"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="1" />
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Padding="0"
                    Style="{StaticResource SurfaceCardStyle}">
                <Grid RowSpacing="0" ColumnSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="84" />
                        <RowDefinition Height="*" MinHeight="84" />
                        <RowDefinition Height="*" MinHeight="84" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border BorderThickness="0,0,1,1" Style="{StaticResource MetadataCardStyle}">
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Uid="DurationLabel" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock MaxLines="1" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionHeadingTextStyle}" Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" BorderThickness="0,0,1,1" Style="{StaticResource MetadataCardStyle}">
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Uid="FileSizeLabel" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock MaxLines="1" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionHeadingTextStyle}" Text="{x:Bind ViewModel.FileSizeText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" BorderThickness="0,0,0,1" Style="{StaticResource MetadataCardStyle}">
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Uid="BitrateLabel" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock MaxLines="1" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionHeadingTextStyle}" Text="{x:Bind ViewModel.BitrateText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" BorderThickness="0,0,1,1" Style="{StaticResource MetadataCardStyle}">
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Uid="VideoCodecLabel" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock MaxLines="1" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionHeadingTextStyle}" Text="{x:Bind ViewModel.VideoCodecText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderThickness="0,0,1,1" Style="{StaticResource MetadataCardStyle}">
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Uid="ResolutionLabel" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock MaxLines="1" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionHeadingTextStyle}" Text="{x:Bind ViewModel.ResolutionText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" BorderThickness="0,0,0,1" Style="{StaticResource MetadataCardStyle}">
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Uid="FrameRateLabel" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock MaxLines="1" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionHeadingTextStyle}" Text="{x:Bind ViewModel.FrameRateText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" BorderThickness="0,0,1,0" Style="{StaticResource MetadataCardStyle}">
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Uid="AudioLabel" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock MaxLines="1" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionHeadingTextStyle}" Text="{x:Bind ViewModel.AudioText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BorderThickness="0,0,1,0" Style="{StaticResource MetadataCardStyle}">
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Uid="ColorLabel" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock MaxLines="1" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionHeadingTextStyle}" Text="{x:Bind ViewModel.ColorText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource MetadataCardStyle}">
                        <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock x:Uid="TracksLabel" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock MaxLines="1" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionHeadingTextStyle}" Text="{x:Bind ViewModel.TracksText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>
                </Border>

                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Uid="CompressVideoButton"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.CompressCommand}"
                        Style="{StaticResource PrimaryButtonStyle}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="18"
                                Glyph="&#xE768;" />
                            <TextBlock
                                x:Uid="CompressVideoButtonText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold" />
                        </Grid>
                    </Button>
                    <Button
                        x:Uid="OpenTrimEditorButton"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.OpenTrimEditorCommand}"
                        Style="{StaticResource SecondaryActionButtonStyle}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="18"
                                Glyph="&#xE8C6;" />
                            <TextBlock
                                x:Uid="OpenTrimEditorButtonText"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold" />
                        </Grid>
                    </Button>
                </Grid>
            </Grid>

            <Grid
                RowSpacing="16"
                Visibility="{x:Bind ViewModel.IsTrimEditor, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="TrimWorkspace" Height="360" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="TrimInspectorColumn" Width="376" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Background="Black"
                        BorderBrush="{StaticResource CliporaBorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CliporaCardCornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="56" />
                            </Grid.RowDefinitions>

                            <Grid Background="Black">
                                <MediaPlayerElement
                                    x:Name="PreviewPlayer"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    AreTransportControlsEnabled="False"
                                    Stretch="Uniform" />
                                <Border
                                    Padding="24"
                                    Background="{StaticResource CliporaScrimBrush}"
                                    IsHitTestVisible="False"
                                    Visibility="{x:Bind ViewModel.ShowPreviewWarning, Mode=OneWay}">
                                    <StackPanel
                                        MaxWidth="430"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            FontSize="26"
                                            Foreground="{StaticResource CliporaCyanBrush}"
                                            Glyph="&#xE7BA;" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Text="{x:Bind ViewModel.PreviewWarningText, Mode=OneWay}"
                                            TextAlignment="Center"
                                            Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border
                                Grid.Row="1"
                                Background="{StaticResource CliporaInsetSurfaceBrush}"
                                BorderBrush="{StaticResource CliporaBorderSubtleBrush}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,12,12">
                                <Grid Padding="14,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="PreviewCurrentTimeText"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource CliporaCyanBrush}"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="12"
                                        Text="00:00.000" />
                                    <StackPanel
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="4">
                                        <Button
                                            x:Uid="PreviewRewindButton"
                                            Click="OnPreviewRewindClick"
                                            Style="{StaticResource PreviewTransportButtonStyle}">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="−5" />
                                        </Button>
                                        <Button
                                            x:Uid="PreviewPlayPauseButton"
                                            Click="OnPreviewPlayPauseClick"
                                            Style="{StaticResource PreviewTransportButtonStyle}">
                                            <FontIcon
                                                x:Name="PreviewPlayPauseGlyph"
                                                FontSize="20"
                                                Glyph="&#xE768;" />
                                        </Button>
                                        <Button
                                            x:Uid="PreviewForwardButton"
                                            Click="OnPreviewForwardClick"
                                            Style="{StaticResource PreviewTransportButtonStyle}">
                                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="+5" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="PreviewTotalTimeText"
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource CliporaSecondaryBrush}"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="12"
                                        Text="00:00.000" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border
                        x:Name="TrimInspector"
                        Grid.Column="1"
                        Height="360"
                        Padding="16"
                        Style="{StaticResource SurfaceCardStyle}">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid MinHeight="40" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Uid="CloseTrimEditorButton"
                                    Width="36"
                                    Height="36"
                                    MinHeight="36"
                                    Padding="0"
                                    Command="{x:Bind ViewModel.CloseTrimEditorCommand}"
                                    Style="{StaticResource SecondaryActionButtonStyle}">
                                    <FontIcon FontSize="15" Glyph="&#xE72B;" />
                                </Button>
                                <Grid Grid.Column="1" VerticalAlignment="Center" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="17"
                                        Foreground="{StaticResource CliporaAccentBrush}"
                                        Glyph="&#xE8C6;" />
                                    <TextBlock
                                        x:Uid="TrimEditorTitle"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource CliporaWhiteBrush}"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Button
                                    x:Uid="ResetTrimSelectionButton"
                                    Grid.Column="2"
                                    Height="36"
                                    MinHeight="36"
                                    Padding="10,0"
                                    Click="OnResetTrimSelectionClick"
                                    Style="{StaticResource SecondaryActionButtonStyle}">
                                    <TextBlock
                                        x:Uid="ResetTrimSelectionButtonText"
                                        FontSize="11"
                                        FontWeight="SemiBold" />
                                </Button>
                            </Grid>

                            <Border
                                Grid.Row="1"
                                Width="48"
                                HorizontalAlignment="Left"
                                Background="{StaticResource CliporaPurpleBrush}"
                                CornerRadius="1" />

                            <Border
                                Grid.Row="2"
                                Padding="12,5"
                                Background="{StaticResource CliporaInsetSurfaceBrush}"
                                BorderBrush="{StaticResource CliporaBorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CliporaInsetCornerRadius}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="34" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon
                                        Width="22"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{StaticResource CliporaAccentBrush}"
                                        Glyph="&#xE8AB;" />
                                    <TextBlock
                                        x:Uid="TrimStartLabel"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="13"
                                        Foreground="{StaticResource CliporaWhiteBrush}"
                                        Text="{x:Bind ViewModel.TrimStartText, Mode=OneWay}" />

                                    <FontIcon
                                        Grid.Row="1"
                                        Width="22"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{StaticResource CliporaCyanBrush}"
                                        Glyph="&#xE8AB;" />
                                    <TextBlock
                                        x:Uid="TrimEndLabel"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="13"
                                        Foreground="{StaticResource CliporaWhiteBrush}"
                                        Text="{x:Bind ViewModel.TrimEndText, Mode=OneWay}" />

                                    <FontIcon
                                        Grid.Row="2"
                                        Width="22"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Foreground="{StaticResource CliporaSecondaryBrush}"
                                        Glyph="&#xE823;" />
                                    <TextBlock
                                        x:Uid="TrimSelectionDurationLabel"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="13"
                                        Foreground="{StaticResource CliporaWhiteBrush}"
                                        Text="{x:Bind ViewModel.TrimSelectionDurationText, Mode=OneWay}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Spacing="8">
                                <Button
                                    x:Uid="TrimAndCompressButton"
                                    Height="48"
                                    MinHeight="48"
                                    HorizontalAlignment="Stretch"
                                    Padding="14,0"
                                    Command="{x:Bind ViewModel.TrimAndCompressCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}">
                                    <StackPanel HorizontalAlignment="Center" Spacing="0">
                                        <TextBlock
                                            x:Uid="TrimAndCompressButtonText"
                                            HorizontalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            x:Uid="TrimAndCompressButtonHint"
                                            HorizontalAlignment="Center"
                                            FontSize="9"
                                            Opacity="0.8" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Uid="TrimOnlyButton"
                                    Height="48"
                                    MinHeight="48"
                                    HorizontalAlignment="Stretch"
                                    Padding="14,0"
                                    Command="{x:Bind ViewModel.TrimOnlyCommand}"
                                    Style="{StaticResource SecondaryActionButtonStyle}">
                                    <StackPanel HorizontalAlignment="Center" Spacing="0">
                                        <TextBlock
                                            x:Uid="TrimOnlyButtonText"
                                            HorizontalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="SemiBold" />
                                        <TextBlock
                                            x:Uid="TrimOnlyButtonHint"
                                            HorizontalAlignment="Center"
                                            FontSize="9"
                                            Foreground="{StaticResource CliporaSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border
                    Grid.Row="1"
                    Padding="14,8"
                    Style="{StaticResource SurfaceCardStyle}">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid MinHeight="22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="TrimTimelineTitle"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource CliporaWhiteBrush}" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <TextBlock
                                    x:Uid="TrimTimelineSelectedLabel"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="12"
                                    Foreground="{StaticResource CliporaCyanBrush}"
                                    Text="{x:Bind ViewModel.TrimSelectionDurationText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <controls:TrimTimelineControl
                                x:Uid="TrimTimeline"
                                DurationSeconds="{x:Bind ViewModel.TrimDurationSeconds, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.TimelineThumbnails, Mode=OneWay}"
                                PlayheadSeconds="{x:Bind ViewModel.TrimPlayheadSeconds, Mode=OneWay}"
                                SeekRequested="OnTrimSeekRequested"
                                SelectionChanged="OnTrimSelectionChanged"
                                SelectionEndSeconds="{x:Bind ViewModel.TrimEndSeconds, Mode=OneWay}"
                                SelectionStartSeconds="{x:Bind ViewModel.TrimStartSeconds, Mode=OneWay}" />
                            <ProgressRing
                                Width="26"
                                Height="26"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsActive="{x:Bind ViewModel.IsGeneratingThumbnails, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsGeneratingThumbnails, Mode=OneWay}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border
                MinHeight="560"
                Padding="24"
                Background="Transparent"
                BorderThickness="0"
                x:Name="ProcessingStatePanel"
                x:Load="{x:Bind ViewModel.IsProcessing, Mode=OneWay}">
                <Grid
                    MaxWidth="860"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    RowSpacing="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource HeadingTextStyle}"
                            Text="{x:Bind ViewModel.ProcessingTitle, Mode=OneWay}"
                            TextAlignment="Center" />
                        <TextBlock
                            MaxWidth="660"
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource CliporaSecondaryBrush}"
                            FontSize="14"
                            Text="{x:Bind ViewModel.ProcessingFileName, Mode=OneWay}"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="1" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="12">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource CliporaAccentBrush}"
                            FontSize="44"
                            FontWeight="SemiBold"
                            Text="{x:Bind ViewModel.ProgressPercentText, Mode=OneWay}" />
                        <ProgressBar
                            Height="8"
                            Background="{StaticResource CliporaInsetSurfaceBrush}"
                            Foreground="{StaticResource CliporaPurpleBrush}"
                            Maximum="100"
                            AutomationProperties.Name="{x:Bind ViewModel.ProcessingProgressAutomationName, Mode=OneWay}"
                            Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
                    </StackPanel>

                    <Grid Grid.Row="2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ProgressMetricCardStyle}">
                            <StackPanel Spacing="7">
                                <TextBlock x:Uid="ProgressFpsLabel" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock MaxLines="1" Text="{x:Bind ViewModel.ProgressFpsText, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource ProgressMetricCardStyle}">
                            <StackPanel Spacing="7">
                                <TextBlock x:Uid="ProgressSpeedLabel" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock MaxLines="1" Text="{x:Bind ViewModel.ProgressSpeedText, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource ProgressMetricCardStyle}">
                            <StackPanel Spacing="7">
                                <TextBlock x:Uid="ProgressElapsedLabel" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock MaxLines="1" Text="{x:Bind ViewModel.ProgressElapsedText, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource ProgressMetricCardStyle}">
                            <StackPanel Spacing="7">
                                <TextBlock x:Uid="ProgressEtaLabel" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock MaxLines="1" Text="{x:Bind ViewModel.ProgressEtaText, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource ProgressMetricCardStyle}">
                            <StackPanel Spacing="7">
                                <TextBlock x:Uid="ProgressSizeLabel" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock MaxLines="1" Text="{x:Bind ViewModel.ProgressSizeText, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Button
                        x:Uid="CancelProcessingButton"
                        Grid.Row="3"
                        MinWidth="220"
                        HorizontalAlignment="Center"
                        Command="{x:Bind ViewModel.CancelProcessingCommand}"
                        Style="{StaticResource SecondaryActionButtonStyle}">
                        <TextBlock
                            x:Uid="CancelProcessingButtonText"
                            FontWeight="SemiBold" />
                    </Button>
                </Grid>
            </Border>

            <Border
                MinHeight="560"
                Padding="24"
                Background="Transparent"
                BorderThickness="0"
                x:Name="SuccessStatePanel"
                x:Load="{x:Bind ViewModel.IsSuccess, Mode=OneWay}">
                <StackPanel
                    MaxWidth="780"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Spacing="18">
                    <Grid
                        Width="72"
                        Height="72"
                        HorizontalAlignment="Center">
                        <Ellipse
                            Fill="{StaticResource CliporaSuccessBrush}"
                            Opacity="0.10" />
                        <Ellipse
                            Margin="7"
                            Stroke="{StaticResource CliporaSuccessBrush}"
                            StrokeThickness="1"
                            Opacity="0.58" />
                        <FontIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource CliporaSuccessBrush}"
                            FontSize="34"
                            Glyph="&#xE930;" />
                    </Grid>
                    <StackPanel Spacing="8">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource HeadingTextStyle}"
                            Text="{x:Bind ViewModel.ResultTitle, Mode=OneWay}"
                            TextAlignment="Center" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind ViewModel.ResultDescription, Mode=OneWay}"
                            TextAlignment="Center" />
                    </StackPanel>

                    <Border Style="{StaticResource InsetSurfaceBorderStyle}" Padding="16,14">
                        <StackPanel Spacing="6">
                            <TextBlock x:Uid="OutputPathLabel" Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock
                                Foreground="{StaticResource CliporaWhiteBrush}"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                MaxLines="2"
                                Text="{x:Bind ViewModel.OutputPath, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ProgressMetricCardStyle}">
                            <StackPanel Spacing="7">
                                <TextBlock Text="{x:Bind ViewModel.OriginalResultSizeLabelText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.OriginalResultSizeText, Mode=OneWay}" Style="{StaticResource SectionHeadingTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource ProgressMetricCardStyle}">
                            <StackPanel Spacing="7">
                                <TextBlock Text="{x:Bind ViewModel.OutputResultSizeLabelText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.OutputResultSizeText, Mode=OneWay}" Style="{StaticResource SectionHeadingTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{StaticResource CliporaSuccessBrush}"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.ResultDifferenceText, Mode=OneWay}"
                        TextAlignment="Center" />

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Uid="RevealOutputButton"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.RevealOutputCommand}"
                            Style="{StaticResource PrimaryButtonStyle}">
                            <TextBlock
                                x:Uid="RevealOutputButtonText"
                                FontWeight="SemiBold"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis" />
                        </Button>
                        <Button
                            x:Uid="ChooseAnotherButton"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.BrowseCommand}"
                            Style="{StaticResource SecondaryActionButtonStyle}">
                            <TextBlock
                                x:Uid="ChooseAnotherButtonText"
                                FontWeight="SemiBold"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis" />
                        </Button>
                        <Button
                            x:Uid="BackToVideoButton"
                            Grid.Column="2"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.BackToPreviousOperationScreenCommand}"
                            Style="{StaticResource SecondaryActionButtonStyle}">
                            <TextBlock
                                x:Uid="BackToVideoButtonText"
                                FontWeight="SemiBold"
                                MaxLines="1"
                                TextTrimming="CharacterEllipsis" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>

